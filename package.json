{
	"name": "unisource-cloud",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "wrangler types --include-env=false --check && vite build",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --include-env=false --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types --include-env=false",
		"proto:lint": "buf lint",
		"proto:generate": "buf generate",
		"proto:format": "buf format --diff --exit-code",
		"proto:check": "pnpm proto:lint && pnpm proto:format && node scripts/check-proto.mjs",
		"proto:check:backend": "node scripts/check-proto.mjs --backend",
		"test:e2e": "playwright test",
		"test:e2e:quotes-layout": "playwright test --config=playwright.quotes-layout.config.ts"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "2.16.0",
		"@clerk/clerk-js": "6.40.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/spark-md5": "3.0.5",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@connectrpc/connect": "2.2.0",
		"@connectrpc/connect-web": "2.2.0",
		"phosphor-svelte": "^3.1.1",
		"spark-md5": "3.0.2",
		"svelte-sonner": "^1.2.1"
	}
}
