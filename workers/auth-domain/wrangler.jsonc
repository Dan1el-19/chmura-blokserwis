{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "unisource-auth-domain",
	"main": "index.mjs",
	"compatibility_date": "2026-11-13",
	"routes": [{ "pattern": "auth.blokserwis.pl", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true, "traces": { "enabled": true } }
}
