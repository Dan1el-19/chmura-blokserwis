{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "chmura-blokserwis",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "chmura.blokserwis.pl",
			"custom_domain": true
		}
	],
	"vars": {
		"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuYXV0aC5ibG9rc2Vyd2lzLnBsJA",
		"PUBLIC_QUOTES_API_URL": "",
		"PUBLIC_CLOUD_API_URL": "https://api.blokserwis.pl"
	},
	"previews": {
		"vars": {
			"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_b3JnYW5pYy1nb3NoYXdrLTg2LmNsZXJrLmFjY291bnRzLmRldiQ",
			"PUBLIC_QUOTES_API_URL": "",
			"PUBLIC_CLOUD_API_URL": "https://api.preview.invalid"
		}
	},
	"workers_dev": false,
	"preview_urls": false
}
